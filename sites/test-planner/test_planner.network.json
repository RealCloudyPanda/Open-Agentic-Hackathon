{
  "metadata": {
    "description": "Spike peer."
  },
  "llm_config": {
    "model_name": "openai/gpt-5-mini"
  },
  "tools": [
    {
      "name": "planning_lead",
      "function": {
        "description": "Turns acceptance criteria into a test plan.",
        "parameters": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string"
            }
          },
          "required": [
            "request"
          ]
        }
      },
      "instructions": "Ask plan_helper, then answer.",
      "tools": [
        "plan_builder"
      ]
    },
    {
      "name": "plan_builder",
      "class": "PlanBuilder",
      "function": {
        "description": "Builds a test plan.",
        "parameters": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string"
            }
          },
          "required": [
            "request"
          ]
        }
      },
      "allow": {
        "to_downstream": {
          "sly_data": [
            "acceptance_criteria",
            "feature_title",
            "platform"
          ]
        }
      }
    }
  ]
}
